<p style="color: green"><%= notice %></p>

<% content_for :title, "Books" %>

<h1><%= t 'activerecord.models.book' %></h1>

<div id="books" class="index-items">
  <% @books.each do |book| %>
    <div class="index-item">
      <%= render book %>
      <p>
        <%= link_to t('.show_book'), book %>
      </p>
    </div>
  <% end %>
</div>

<nav class="page-nav">
  <%= link_to t('.new_book'), new_book_path %>
</nav>
